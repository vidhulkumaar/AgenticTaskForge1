# ForgeAI Environment Configuration
# Copy this file to .env and adjust as necessary.

# ── LLM Configuration ──
# The base URL of the Ollama server
# OLLAMA_BASE_URL=http://localhost:11434

# The name of the LLM model to use for planning/reasoning
# OLLAMA_MODEL=qwen3:4b

# The name of the embedding model to use for the recipe store
# OLLAMA_EMBED_MODEL=nomic-embed-text

# ── Timeouts & Retries ──
# Maximum time (in seconds) to wait for the LLM to respond
# LLM_TIMEOUT=120

# Maximum number of retries for certain operations
# MAX_RETRIES=10

# ── Executable Paths ──
# Optional: explicitly set the path to Tesseract OCR if it is not found automatically
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
